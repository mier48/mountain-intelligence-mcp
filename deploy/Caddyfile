# Caddy reverse proxy for Mountain Intelligence MCP (used by compose.prod.yaml).
# Certificates for {$MCP_PUBLIC_DOMAIN} are obtained and renewed automatically; the DNS record must
# point to this host and ports 80/443 must be reachable before the first start.
# Caddy redacts the Authorization header in its access logs by default.
#
# Validate after editing:  docker compose run --rm --no-deps caddy caddy validate --config /etc/caddy/Caddyfile
# Apply without downtime:  docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

{$MCP_PUBLIC_DOMAIN} {
	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Only the MCP endpoint and the health probe are exposed (keep in sync with MCP_HTTP_PATH).
	@mcp path /mcp /mcp/* /healthz
	handle @mcp {
		request_body {
			max_size 1MB
		}
		reverse_proxy mountain-intelligence-mcp:8000 {
			flush_interval -1
		}
	}

	handle {
		respond "Not found" 404
	}
}
