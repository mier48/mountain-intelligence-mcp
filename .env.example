# Copy to .env and fill in. Never commit .env.

# --- Production on a VPS (README, "Despliegue en VPS") ---
# Uncomment both lines on the server: Caddy (TLS) becomes the only published service.
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
# MCP_PUBLIC_DOMAIN=mountain-mcp.ltrapi.com
# If an existing Traefik owns 80/443 (README, "6b"): COMPOSE_FILE=compose.yaml:compose.traefik.yaml
# and set these to match that Traefik (no host port is published then):
# TRAEFIK_NETWORK=traefik_proxy
# TRAEFIK_ENTRYPOINT=websecure
# Host ports Caddy publishes (compose.prod.yaml only). Public ACME needs the real 80/443.
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443

# --- PostgreSQL (used by the postgres container and by the app) ---
POSTGRES_DB=mountain_intelligence
POSTGRES_USER=mountain
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# Outside Docker Compose also set POSTGRES_HOST / POSTGRES_PORT (defaults: localhost / 5432).

# --- MCP HTTP endpoint ---
# REQUIRED. Comma-separated bearer tokens accepted by the HTTP transport.
# Generate one with: openssl rand -hex 32   (docker compose refuses to start while this is empty)
MCP_AUTH_TOKENS=
# Development only: allow HTTP access without a token. Never enable on a reachable host.
MCP_ALLOW_UNAUTHENTICATED=false
# Host header allowlist (DNS-rebinding protection). With compose.prod.yaml it is derived from
# MCP_PUBLIC_DOMAIN automatically; this value only applies to local/development runs.
MCP_ALLOWED_HOSTS=localhost,localhost:*,127.0.0.1,127.0.0.1:*
# Browser origins allowed to call the endpoint (leave empty for non-browser clients).
MCP_ALLOWED_ORIGINS=
MCP_HTTP_PATH=/mcp
MCP_RATE_LIMIT_PER_MINUTE=120
# Host port for the MCP endpoint (bound to 127.0.0.1). Not used with compose.prod.yaml.
MCP_PUBLISHED_PORT=8000
# Behind a reverse proxy: start with --proxy-headers and list the proxy IPs here
# (compose.prod.yaml sets both for the bundled Caddy).
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Catalog ---
# Synthetic demo fixtures are hidden from MCP answers unless this is true (demo environments only).
MI_INCLUDE_SYNTHETIC_DATA=false
MI_STALE_AFTER_DAYS=120
MI_OFFER_MAX_AGE_DAYS=7

# --- Ingestion ---
# Scheduled syncs are off by default; only enabled + authorized sources are ever synced.
INGESTION_SCHEDULE_ENABLED=false
INGESTION_SCHEDULER_INTERVAL_SECONDS=900
INGESTION_USER_AGENT=MountainIntelligenceBot/0.1 (+contact: ops@example.com)
INGESTION_MIN_DELAY_SECONDS=2.0
INGESTION_RESPECT_ROBOTS_TXT=true

# --- Misc ---
LOG_LEVEL=INFO
DB_STATEMENT_TIMEOUT_MS=15000
# Optional; nothing is signed with it (no sessions/cookies). A random key is used if empty.
DJANGO_SECRET_KEY=
